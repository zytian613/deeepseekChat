# =============================================================
# DeepSeek Chat 环境变量示例
# 复制本文件为 .env.local 后填写真实值：
#   cp .env.example .env.local   (PowerShell: Copy-Item .env.example .env.local)
# 注意：.env.local 已被 .gitignore 忽略，切勿提交真实密钥。
# =============================================================

# DeepSeek API Key（必填，仅保存在服务端，绝不暴露到前端）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# DeepSeek API 地址（OpenAI 兼容）。默认即可，也可用 https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-chat（对话）/ deepseek-reasoner（推理，含 reasoning_content）
DEEPSEEK_MODEL=deepseek-chat

# SQLite 数据库文件
DATABASE_URL=file:./dev.db

# Mock 模式：没有 API Key 时保持 true 即可本地跑通；配置真实 Key 后改为 false
MOCK_LLM=true
